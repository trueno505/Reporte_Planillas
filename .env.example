# Copia este archivo como .env y completa con las credenciales reales de tu proyecto Supabase.
# El .env real NO debe versionarse (ver .gitignore).
#
# Dónde obtener estos valores:
#   Supabase → Project Settings → API
#     · VITE_SUPABASE_URL      = "Project URL"
#     · VITE_SUPABASE_ANON_KEY = "Project API keys" → clave "anon" (pública)
#
# Solo se usan estas dos variables (las lee src/lib/supabaseClient.js).
# Deben empezar con el prefijo VITE_ para que Vite las exponga al frontend.
#
# En producción (Vercel): NO se sube el .env. Configura estas mismas dos variables
# en Vercel → Settings → Environment Variables.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
